{
  "openfrenz_model": "pipeline",
  "name": "eog",
  "version": "0.2",
  "step": { "stream": "eeg", "samples": 25 },
  "nodes": [
    { "name": "pairs", "op": "mix", "in": "eeg", "channels": [
      { "name": "blink", "weights": { "forehead_left": 0.5, "forehead_right": 0.5, "comb_left": -0.5, "comb_right": -0.5 } },
      { "name": "gaze_horizontal", "weights": { "forehead_left": 1, "forehead_right": -1 } }
    ] },

    { "name": "blink_channel", "op": "select", "in": "pairs", "channels": ["blink"] },
    { "name": "blink_band", "op": "filter", "in": "blink_channel", "start": "settled",
      "steps": [{ "type": "bandpass", "low": 0.5, "high": 8 }] },
    { "name": "blinks", "op": "peaks", "in": "blink_band",
      "threshold": 3, "back_s": 2, "ahead_s": 0.25, "min_gap_s": 0.25, "scale_half_life_s": 120 },

    { "name": "gaze_channel", "op": "select", "in": "pairs", "channels": ["gaze_horizontal"] },
    { "name": "gaze_slow", "op": "filter", "in": "gaze_channel", "start": "settled",
      "steps": [{ "type": "lowpass", "high": 8 }] },
    { "name": "gaze", "op": "jumps", "in": "gaze_slow",
      "threshold": 6, "leak_s": 5, "min_gap_s": 0.12, "scale_half_life_s": 120 }
  ],
  "outputs": ["blinks", "gaze"]
}
